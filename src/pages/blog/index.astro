---
// src/pages/blog/index.astro
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
// Editorial writing leads; the daily briefs get their own compact list so a
// month of automated posts never buries the long-form pieces.
const posts = allPosts.filter((p) => !p.data.autoGenerated);
const briefs = allPosts.filter((p) => p.data.autoGenerated);
const latestBriefs = briefs.slice(0, 10);

const categoryLabel: Record<string, string> = {
  security: "Security",
  cloud: "Cloud",
  compliance: "Compliance",
  engineering: "Engineering",
  industry: "Industry Brief",
};

const dateFmt = new Intl.DateTimeFormat("en-KE", { year: "numeric", month: "long", day: "numeric" });
---

<Layout
  title="Engineering Notes — CloudGrid Africa Blog"
  description="Editorial writing and daily curated briefs on cloud engineering, cybersecurity, and Kenya DPA 2019 compliance from CloudGrid Africa's engineering team."
>
  <Navbar />
  <main id="main-content" class="pt-32 pb-24">
    <div class="cga-container">
      <div class="mb-14 max-w-2xl">
        <p class="cga-eyebrow">Engineering notes</p>
        <h1 class="cga-section-title">
          Writing from the people who build the systems.
        </h1>
        <p class="mt-4 text-base leading-relaxed text-ink-secondary">
          Long-form engineering and compliance writing, plus a daily curated brief on Kenya,
          Africa, and world tech signal relevant to what we build.
        </p>
      </div>

      <div class="divide-y divide-midnight-border border-y border-midnight-border">
        {
          posts.map((post) => (
            <a href={`/blog/${post.slug}/`} class="group flex flex-col gap-2 py-7 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8">
              <div class="sm:max-w-xl">
                <div class="flex flex-wrap items-center gap-3">
                  <span class="text-[13px] text-signal-blue">
                    {categoryLabel[post.data.category]}
                  </span>
                </div>
                <h2 class="mt-2 text-[17px] font-semibold text-white transition-colors duration-200 group-hover:text-signal-blue">
                  {post.data.title}
                </h2>
                <p class="mt-1.5 text-[13.5px] leading-relaxed text-ink-secondary">
                  {post.data.description}
                </p>
              </div>
              <time datetime={post.data.publishDate.toISOString()} class="shrink-0 font-mono text-[12px] text-ink-faint sm:text-right">
                {dateFmt.format(post.data.publishDate)}
              </time>
            </a>
          ))
        }
      </div>

      {
        posts.length === 0 && (
          <p class="py-16 text-ink-muted">No articles yet. The daily briefs below are updated every morning.</p>
        )
      }

      <section class="mt-20" aria-labelledby="briefs-heading">
        <div class="flex flex-wrap items-baseline justify-between gap-4">
          <div>
            <h2 id="briefs-heading" class="text-2xl font-semibold tracking-[-0.02em] text-white">Daily briefs</h2>
            <p class="mt-2 max-w-[60ch] text-[15px] text-ink-secondary">
              Three stories each morning from security, cloud and East African tech sources, with links to the originals.
            </p>
          </div>
          <a href="/blog/briefs/" class="text-sm font-medium text-signal-blue hover:underline">
            All {briefs.length} briefs
          </a>
        </div>
        <ul class="mt-6 divide-y divide-midnight-border border-y border-midnight-border">
          {
            latestBriefs.map((b) => (
              <li>
                <a href={`/blog/${b.slug}/`} class="group grid grid-cols-1 gap-1 py-4 sm:grid-cols-[10rem_1fr] sm:gap-6">
                  <time datetime={b.data.publishDate.toISOString()} class="text-sm text-ink-muted" data-figure>
                    {dateFmt.format(b.data.publishDate)}
                  </time>
                  <span class="text-[15px] text-ink-primary group-hover:text-signal-blue">{b.data.description}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </main>
  <Footer />

  <!-- Semantic web: Blog + BreadcrumbList for the listing page itself.
       itemListElement references each post's own URL — kept inside
       <Layout> for the same reason as the per-post page: content after the
       closing </Layout> tag falls outside <body> and won't render reliably. -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Blog",
        "@id": "https://cloudgridafrica.com/blog/#blog",
        "name": "CloudGrid Africa — Engineering Notes",
        "url": "https://cloudgridafrica.com/blog/",
        "publisher": { "@id": "https://cloudgridafrica.com/#organization" },
        "blogPost": posts.map((post) => ({
          "@type": "BlogPosting",
          "headline": post.data.title,
          "datePublished": post.data.publishDate.toISOString(),
          "url": `https://cloudgridafrica.com/blog/${post.slug}/`,
        })),
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cloudgridafrica.com/" },
          { "@type": "ListItem", "position": 2, "name": "Engineering Notes", "item": "https://cloudgridafrica.com/blog/" },
        ],
      },
    ],
  })} />
</Layout>
