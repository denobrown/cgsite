---
// src/pages/blog/[slug].astro
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await post.render();

const dateFmt = new Intl.DateTimeFormat("en-KE", { year: "numeric", month: "long", day: "numeric" });

const categoryLabel: Record<string, string> = {
  security: "Security",
  cloud: "Cloud",
  compliance: "Compliance",
  engineering: "Engineering",
  industry: "Industry Brief",
};
---

<Layout
  title={`${post.data.title} — CloudGrid Africa`}
  description={post.data.description}
  article={{
    publishedTime: post.data.publishDate.toISOString(),
    modifiedTime: post.data.updatedDate?.toISOString(),
    author: post.data.author,
    tags: post.data.tags,
  }}
>
  <Navbar />
  <main id="main-content" class="pt-32 pb-24">
    <article class="cga-container">
      <div class="mx-auto max-w-2xl">
        <a href="/blog" class="text-[13px] text-ink-muted hover:text-ink-primary">← Engineering Notes</a>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-signal-blue">
            {categoryLabel[post.data.category]}
          </span>
          {post.data.autoGenerated && (
            <span class="rounded border border-midnight-border px-1.5 py-0.5 font-mono text-[9.5px] uppercase tracking-wide text-ink-faint">
              Auto-Generated
            </span>
          )}
        </div>

        <h1 class="mt-4 text-3xl font-bold leading-tight tracking-tight text-white sm:text-4xl">
          {post.data.title}
        </h1>

        <div class="mt-5 flex items-center gap-3 border-b border-midnight-border pb-6 font-mono text-[12.5px] text-ink-muted">
          <span>{post.data.author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={post.data.publishDate.toISOString()}>{dateFmt.format(post.data.publishDate)}</time>
        </div>

        <div
          class="prose prose-invert prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-white prose-p:text-[15px] prose-p:leading-relaxed prose-p:text-ink-secondary prose-a:text-signal-blue prose-a:no-underline hover:prose-a:underline prose-strong:text-ink-primary prose-li:text-ink-secondary prose-hr:border-midnight-border mt-10 max-w-none"
        >
          <Content />
        </div>

        {
          post.data.tags.length > 0 && (
            <div class="mt-12 flex flex-wrap gap-2 border-t border-midnight-border pt-8">
              {post.data.tags.map((tag) => (
                <span class="rounded-full border border-midnight-border px-3 py-1 font-mono text-[11px] text-ink-muted">
                  {tag}
                </span>
              ))}
            </div>
          )
        }
      </div>
    </article>
  </main>
  <Footer />

  <!-- Semantic web: BlogPosting + BreadcrumbList, scoped to this exact post
       and built directly from its content-collection frontmatter — nothing
       hand-duplicated. BlogPosting is what makes individual posts eligible
       for Google's Article rich-result treatment (byline, publish date,
       thumbnail); BreadcrumbList surfaces the Home › Blog › Post trail in
       search results instead of a bare URL.
       NOTE: this MUST stay inside <Layout>...</Layout> — Layout renders the
       whole <html> document, so anything placed as a sibling after the
       closing </Layout> tag ends up outside <body> entirely and is not
       reliably rendered. -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BlogPosting",
        "headline": post.data.title,
        "description": post.data.description,
        "datePublished": post.data.publishDate.toISOString(),
        ...(post.data.updatedDate ? { "dateModified": post.data.updatedDate.toISOString() } : {}),
        "author": { "@type": "Person", "name": post.data.author },
        "publisher": { "@id": "https://cloudgridafrica.com/#organization" },
        "keywords": post.data.tags.join(", "),
        "mainEntityOfPage": { "@type": "WebPage", "@id": `https://cloudgridafrica.com/blog/${post.slug}/` },
        "url": `https://cloudgridafrica.com/blog/${post.slug}/`,
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cloudgridafrica.com/" },
          { "@type": "ListItem", "position": 2, "name": "Engineering Notes", "item": "https://cloudgridafrica.com/blog/" },
          { "@type": "ListItem", "position": 3, "name": post.data.title, "item": `https://cloudgridafrica.com/blog/${post.slug}/` },
        ],
      },
    ],
  })} />
</Layout>
