---
// src/pages/blog/briefs.astro — full archive of the automated daily briefs.
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

const briefs = (await getCollection("blog", ({ data }) => !data.draft && data.autoGenerated)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const monthFmt = new Intl.DateTimeFormat("en-KE", { month: "long", year: "numeric", timeZone: "UTC" });
const dayFmt = new Intl.DateTimeFormat("en-KE", { day: "numeric", month: "short", timeZone: "UTC" });
const byMonth = new Map<string, typeof briefs>();
for (const b of briefs) {
  const key = monthFmt.format(b.data.publishDate);
  byMonth.set(key, [...(byMonth.get(key) ?? []), b]);
}
---

<Layout
  title="Daily briefs — CloudGrid Africa"
  description="Archive of CloudGrid Africa's daily briefs: three security, cloud and East African tech stories each morning, linked to their sources."
>
  <Navbar />
  <main id="main-content" class="pt-32 pb-24">
    <div class="cga-container">
      <a href="/blog/" class="text-sm text-signal-blue hover:underline">Back to the blog</a>
      <h1 class="cga-section-title">Daily briefs</h1>
      <p class="mt-4 max-w-[60ch] text-base leading-relaxed text-ink-secondary">
        Published automatically every morning at 08:00 Nairobi time. {briefs.length} so far.
      </p>

      {
        [...byMonth].map(([month, items]) => (
          <section class="mt-14">
            <h2 class="text-lg font-semibold text-white">{month}</h2>
            <ul class="mt-4 divide-y divide-midnight-border border-y border-midnight-border">
              {items.map((b) => (
                <li>
                  <a href={`/blog/${b.slug}/`} class="group grid grid-cols-1 gap-1 py-4 sm:grid-cols-[6rem_1fr] sm:gap-6">
                    <time datetime={b.data.publishDate.toISOString()} class="text-sm text-ink-muted" data-figure>
                      {dayFmt.format(b.data.publishDate)}
                    </time>
                    <span class="text-[15px] text-ink-primary group-hover:text-signal-blue">{b.data.description}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </main>
  <Footer />
</Layout>
