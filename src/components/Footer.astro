---
// src/components/Footer.astro
const year = new Date().getFullYear();

const columns = [
  {
    heading: "Company",
    links: [
      { label: "Services", href: "/#capabilities" },
      { label: "Case Studies", href: "/#case-studies" },
      { label: "Team", href: "/#team" },
      { label: "Blog", href: "/blog" },
    ],
  },
  {
    heading: "Compliance",
    links: [
      { label: "Kenya DPA 2019", href: "/#capabilities" },
      { label: "ISO 27001", href: "/#case-studies" },
      { label: "OWASP Top 10", href: "/#case-studies" },
      { label: "CBK Cloud Guidance", href: "/#capabilities" },
    ],
  },
  {
    heading: "Legal",
    links: [
      { label: "Privacy Policy", href: "/privacy" },
      { label: "Terms & Conditions", href: "/terms" },
    ],
  },
];
---

<footer class="border-t border-midnight-border">
  <div class="cga-container py-16">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <!-- Brand + contact — kept minimal here deliberately. The full
           logo + tagline treatment already appears in the navbar and hero;
           repeating the same description again in the footer read as
           redundant. This keeps just the mark (a normal footer convention)
           and the actual contact details, which aren't restated anywhere
           else on the page. -->
      <div>
        <div class="flex items-center gap-2">
          <img src="/logo-icon.png" alt="" width="20" height="20" class="h-5 w-5 shrink-0" />
          <span class="text-[13.5px] font-semibold text-white">CloudGrid Africa</span>
        </div>
        <address class="mt-5 space-y-1.5 font-mono text-[13px] not-italic text-ink-muted">
          <p>
            <a href="mailto:hello@cloudgridafrica.com" class="hover:text-ink-primary">hello@cloudgridafrica.com</a>
          </p>
          <p>
            <a href="tel:+254721656835" class="hover:text-ink-primary">+254 721 656 835</a>
          </p>
          <p>Westlands Business District, Nairobi, Kenya</p>
        </address>
      </div>

      {
        columns.map((col) => (
          <div>
            <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-ink-faint">{col.heading}</p>
            <ul class="mt-4 space-y-2.5">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} class="text-[13.5px] text-ink-secondary hover:text-white">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-midnight-border pt-8 sm:flex-row">
      <p class="text-[12.5px] text-ink-faint">
        © {year} CloudGrid Africa. All systems engineered in Nairobi.
      </p>
      <div class="flex items-center gap-2 font-mono text-[11px] text-ink-faint">
        <span class="h-1.5 w-1.5 rounded-full bg-signal-emerald"></span>
        All systems operational
      </div>
    </div>
  </div>
</footer>
