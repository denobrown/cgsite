---
// src/components/Footer.astro
const year = new Date().getFullYear();

const columns = [
  {
    heading: "Company",
    links: [
      { label: "Services", href: "/#capabilities" },
      { label: "Case Studies", href: "/#case-studies" },
      { label: "Team", href: "/#team" },
      { label: "Blog", href: "/blog" },
    ],
  },
  {
    heading: "Compliance",
    links: [
      { label: "Kenya DPA 2019", href: "/#capabilities" },
      { label: "ISO 27001", href: "/#case-studies" },
      { label: "OWASP Top 10", href: "/#case-studies" },
      { label: "CBK Cloud Guidance", href: "/#capabilities" },
    ],
  },
  {
    heading: "Legal",
    links: [
      { label: "Privacy Policy", href: "/privacy" },
      { label: "Terms & Conditions", href: "/terms" },
    ],
  },
];
---

<footer class="border-t border-midnight-border">
  <div class="cga-container py-16">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <!-- Brand + contact -->
      <div>
        <div class="flex items-center gap-2.5">
          <svg width="22" height="22" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="0.5" y="0.5" width="25" height="25" rx="6.5" stroke="#2A3345" stroke-width="1" />
            <path d="M13 5.5L19.5 9.2V16.8L13 20.5L6.5 16.8V9.2L13 5.5Z" stroke="#3B82F6" stroke-width="1.4" stroke-linejoin="round" />
            <circle cx="13" cy="13" r="1.6" fill="#10B981" />
          </svg>
          <span class="text-[15px] font-semibold text-white">CloudGrid Africa</span>
        </div>
        <p class="mt-4 max-w-xs text-[13.5px] leading-relaxed text-ink-secondary">
          Cloud &amp; cybersecurity engineering for East African enterprise. Co-located at Raxio
          Data Centre, Nairobi — a Tier III facility.
        </p>
        <address class="mt-6 space-y-1.5 font-mono text-[13px] not-italic text-ink-muted">
          <p>
            <a href="mailto:hello@cloudgridafrica.com" class="hover:text-ink-primary">hello@cloudgridafrica.com</a>
          </p>
          <p>
            <a href="tel:+254721656835" class="hover:text-ink-primary">+254 721 656 835</a>
          </p>
          <p>Westlands Business District, Nairobi, Kenya</p>
        </address>
      </div>

      {
        columns.map((col) => (
          <div>
            <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-ink-faint">{col.heading}</p>
            <ul class="mt-4 space-y-2.5">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} class="text-[13.5px] text-ink-secondary hover:text-white">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-midnight-border pt-8 sm:flex-row">
      <p class="text-[12.5px] text-ink-faint">
        © {year} CloudGrid Africa. All systems engineered in Nairobi.
      </p>
      <div class="flex items-center gap-2 font-mono text-[11px] text-ink-faint">
        <span class="h-1.5 w-1.5 rounded-full bg-signal-emerald"></span>
        All systems operational
      </div>
    </div>
  </div>
</footer>
