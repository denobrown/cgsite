---
// src/components/ContactSection.astro
//
// Replaces the email-form version with a real, embedded Calendly booking
// flow — https://calendly.com/dmurila — so a visitor can actually book a
// slot without leaving the site or waiting on an email reply.
//
// CSP: this needed two real, documented allowances (assets.calendly.com in
// script-src, calendly.com in frame-src) — see
// scripts/lib/collect-inline-script-hashes.mjs for exactly why each one is
// there. Nothing else about the CSP changed.
//
// Colors: Calendly's free embed customization accepts background_color /
// text_color / primary_color as URL params on the widget's data-url — used
// here to match this site's exact palette (midnight canvas, ink-primary
// text, the real CloudGrid brand blue) instead of showing Calendly's
// default white panel, which would otherwise be a jarring, obviously
// third-party-feeling box dropped into an otherwise dark page.
//
// Loading: the widget script is lazy-loaded on scroll-into-view, same
// IntersectionObserver bootstrap pattern as TechIntelHub — this section
// sits well below the fold, so there's no reason to load Calendly's script
// for a visitor who never scrolls this far.

const CALENDLY_BASE = "https://calendly.com/dmurila";
// hide_landing_page_details + hide_gdpr_banner drop the intro block and the
// cookie banner, which is most of the dead space above the event list.
const CALENDLY_URL = `${CALENDLY_BASE}?hide_landing_page_details=1&hide_gdpr_banner=1&background_color=0b0f17&text_color=e2e8f0&primary_color=155dba`;
---

<section id="contact" class="py-20 sm:py-28">
  <div class="cga-container">
    <div class="grid grid-cols-1 gap-14 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-5">
        <p class="cga-eyebrow">Get in touch</p>
        <h2 class="cga-section-title">
          Book an engineering consultation.
        </h2>
        <p class="mt-5 max-w-md text-[15px] leading-relaxed text-ink-secondary">
          Tell us what you're running and where it hurts. A principal engineer — not a sales
          rep — picks the call directly.
        </p>
        <p class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-1 text-[15px] text-ink-muted">
          Or email
          <a href="mailto:info@cloudgridafrica.com" class="text-signal-blue hover:underline">info@cloudgridafrica.com</a>
        </p>
      </div>

      <!-- Phones: a compact booking card instead of a 650px iframe. The full
           calendar opens on calendly.com, which is a better picker on a small
           screen anyway, and the widget script is never downloaded. -->
      <div class="cga-card p-6 lg:hidden lg:col-span-7">
        <p class="text-[13px] text-ink-faint">Engineering consultation</p>
        <p class="mt-2 text-[14px] leading-relaxed text-ink-secondary">
          Pick a slot that suits you. Times are shown in your local timezone.
        </p>
        <a
          href={CALENDLY_BASE}
          target="_blank"
          rel="noopener noreferrer"
          class="cga-btn-primary mt-5 w-full"
        >
          Choose a time
        </a>
      </div>

      <!-- Desktop: inline embed, only loaded at lg+ -->
      <div class="cga-card hidden overflow-hidden p-2 lg:col-span-7 lg:block" data-calendly-container>
        <div class="relative">
          <div
            class="calendly-inline-widget h-[560px] min-w-[280px]"
            data-url={CALENDLY_URL}
            data-calendly-widget
          >
          </div>
          <!-- Loading state: a skeleton shaped like Calendly's event list,
               removed once the iframe reports it has loaded. The link keeps
               booking possible if the embed never arrives. -->
          <div class="absolute inset-0 flex flex-col gap-4 p-8" data-calendly-fallback>
            <div class="h-5 w-40 animate-pulse rounded bg-midnight-raised"></div>
            <div class="h-4 w-64 animate-pulse rounded bg-midnight-raised"></div>
            <div class="mt-4 h-16 animate-pulse rounded-md bg-midnight-raised"></div>
            <div class="h-16 animate-pulse rounded-md bg-midnight-raised"></div>
            <p class="mt-auto text-sm text-ink-muted">
              Calendar not loading?
              <a href={CALENDLY_BASE} target="_blank" rel="noopener noreferrer" class="text-signal-blue hover:underline">Book on calendly.com</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var container = document.querySelector("[data-calendly-container]");
    if (!container) return;
    // Phones get the compact link card; don't pull Calendly's script at all.
    if (window.matchMedia && !window.matchMedia("(min-width: 1024px)").matches) return;
    var loaded = false;

    function loadCalendly() {
      if (loaded) return;
      loaded = true;
      var s = document.createElement("script");
      s.src = "https://assets.calendly.com/assets/external/widget.js";
      s.async = true;
      var fallback = container.querySelector("[data-calendly-fallback]");
      var widget = container.querySelector("[data-calendly-widget]");
      function hideFallback() {
        if (fallback) fallback.style.display = "none";
      }
      // Calendly injects its iframe after the script runs; hide the
      // skeleton when that iframe finishes loading, not when the script does.
      if (widget && "MutationObserver" in window) {
        new MutationObserver(function (_, obs) {
          var frame = widget.querySelector("iframe");
          if (frame) {
            frame.addEventListener("load", hideFallback, { once: true });
            obs.disconnect();
          }
        }).observe(widget, { childList: true, subtree: true });
      } else {
        s.onload = hideFallback;
      }
      document.body.appendChild(s);
    }

    if (!("IntersectionObserver" in window)) {
      loadCalendly();
      return;
    }
    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            loadCalendly();
            observer.disconnect();
          }
        });
      },
      { rootMargin: "400px" }
    );
    observer.observe(container);
  })();
</script>
