---
// src/components/ContactSection.astro
//
// Replaces the email-form version with a real, embedded Calendly booking
// flow — https://calendly.com/dmurila — so a visitor can actually book a
// slot without leaving the site or waiting on an email reply.
//
// CSP: this needed two real, documented allowances (assets.calendly.com in
// script-src, calendly.com in frame-src) — see
// scripts/lib/collect-inline-script-hashes.mjs for exactly why each one is
// there. Nothing else about the CSP changed.
//
// Colors: Calendly's free embed customization accepts background_color /
// text_color / primary_color as URL params on the widget's data-url — used
// here to match this site's exact palette (midnight canvas, ink-primary
// text, the real CloudGrid brand blue) instead of showing Calendly's
// default white panel, which would otherwise be a jarring, obviously
// third-party-feeling box dropped into an otherwise dark page.
//
// Loading: the widget script is lazy-loaded on scroll-into-view, same
// IntersectionObserver bootstrap pattern as TechIntelHub — this section
// sits well below the fold, so there's no reason to load Calendly's script
// for a visitor who never scrolls this far.

const CALENDLY_URL =
  "https://calendly.com/dmurila?background_color=0b0f17&text_color=e2e8f0&primary_color=155dba";
---

<section id="contact" class="py-24 sm:py-32">
  <div class="cga-container">
    <div class="mx-auto grid max-w-5xl grid-cols-1 gap-14 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
      <div>
        <p class="cga-eyebrow">Get in touch</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Schedule an engineering consultation.
        </h2>
        <p class="mt-5 max-w-sm text-[14.5px] leading-relaxed text-ink-secondary">
          Tell us what you're running and where it hurts. A principal engineer — not a sales
          rep — picks the call directly.
        </p>
        <p class="mt-6 flex items-center gap-2 font-mono text-[12.5px] text-ink-muted">
          <span class="h-1.5 w-1.5 rounded-full bg-signal-emerald"></span>
          Or reach us directly:
          <a href="mailto:hello@cloudgridafrica.com" class="text-signal-blue hover:underline">hello@cloudgridafrica.com</a>
        </p>
      </div>

      <div class="cga-card overflow-hidden p-2" data-calendly-container>
        <div
          class="calendly-inline-widget"
          data-url={CALENDLY_URL}
          data-calendly-widget
          style="min-width:280px; height:650px;"
        >
        </div>
        <!-- Static fallback, visible until the widget loads (or if JS never runs) -->
        <div class="p-6 text-center" data-calendly-fallback>
          <p class="text-[13.5px] text-ink-secondary">
            Loading the booking calendar — if it doesn't appear,
            <a href="https://calendly.com/dmurila" target="_blank" rel="noopener noreferrer" class="text-signal-blue hover:underline">
              open it directly
            </a>.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var container = document.querySelector("[data-calendly-container]");
    if (!container) return;
    var loaded = false;

    function loadCalendly() {
      if (loaded) return;
      loaded = true;
      var s = document.createElement("script");
      s.src = "https://assets.calendly.com/assets/external/widget.js";
      s.async = true;
      s.onload = function () {
        var fallback = container.querySelector("[data-calendly-fallback]");
        if (fallback) fallback.style.display = "none";
      };
      document.body.appendChild(s);
    }

    if (!("IntersectionObserver" in window)) {
      loadCalendly();
      return;
    }
    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            loadCalendly();
            observer.disconnect();
          }
        });
      },
      { rootMargin: "400px" }
    );
    observer.observe(container);
  })();
</script>
