---
// src/components/Hero.astro
//
// Left-aligned, two-column hero. The left side says what CloudGrid does and
// offers two actions. The right side is a short fact sheet: things a buyer
// can verify (where the infrastructure lives, which frameworks the work is
// built against, who answers the call), set as a definition list rather
// than a row of big-number stat tiles.

// White-on-transparent marks generated from each client's own logo file
// (backgrounds removed, recoloured to a single tone) so the strip reads as
// one set on the navy canvas instead of nine differently-coloured boxes.
// w/h are the display size in CSS px (cls sets the same height; the CSP
// blocks inline style attributes, so sizing has to come from classes); the files are ~2x that for retina.
// h is tuned per logo for optical balance (wide wordmarks sit shorter).
const clients: { name: string; logo: string; w: number; h: number; cls: string }[] = [
  { name: "PrimeDrive Imports", logo: "/clients/primedrive-imports.webp", w: 51, h: 40, cls: "h-10" },
  { name: "BIXA Medical & Surgical Specialist Hospital", logo: "/clients/bxa-medical.webp", w: 53, h: 34, cls: "h-[34px]" },
  { name: "Pinnoserv", logo: "/clients/pinnoserv.webp", w: 78, h: 30, cls: "h-[30px]" },
  { name: "Cherie Africa", logo: "/clients/cherie-africa.webp", w: 35, h: 40, cls: "h-10" },
  { name: "Ethereal Pharma", logo: "/clients/ethereal-pharma.webp", w: 38, h: 40, cls: "h-10" },
  { name: "Fayhope Express", logo: "/clients/fayhope-express.webp", w: 43, h: 38, cls: "h-[38px]" },
  { name: "KayFarm", logo: "/clients/kayfarm.webp", w: 40, h: 40, cls: "h-10" },
  { name: "One Dance Safaris", logo: "/clients/one-dance-safaris.webp", w: 41, h: 38, cls: "h-[38px]" },
  { name: "R.O.G Church", logo: "/clients/rog-church.webp", w: 35, h: 40, cls: "h-10" },
];

const facts = [
  { term: "Infrastructure", detail: "Co-located at Raxio Data Centre, Nairobi (Tier III)" },
  { term: "Built against", detail: "Kenya DPA 2019, ISO 27001, PCI-DSS, CBK cloud guidance" },
  { term: "Payments", detail: "M-Pesa Daraja integrations with idempotent reconciliation" },
  { term: "Who you talk to", detail: "A principal engineer, from first call to handover" },
];
---

<section class="relative pt-32 pb-16 sm:pt-40 sm:pb-20">
  <div class="cga-container">
    <div class="grid grid-cols-1 gap-14 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7">
        <h1
          class="text-[2.75rem] sm:max-w-[15ch] font-semibold leading-[1.02] tracking-[-0.04em] text-white animate-fade-up sm:text-[3.5rem] lg:text-[4rem]"
        >
          Cloud and security engineering for East African enterprise.
        </h1>

        <p
          class="mt-7 max-w-[58ch] text-[17px] leading-[1.65] text-ink-secondary animate-fade-up [animation-delay:80ms]"
        >
          We design and run cloud environments, secure payment and transaction
          pipelines, and build to the Kenya Data Protection Act 2019 from day one.
          Nairobi engineers, working on local infrastructure.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row animate-fade-up [animation-delay:160ms]">
          <a href="/#contact" class="cga-btn-primary">Book a consultation</a>
          <a href="/#case-studies" class="cga-btn-secondary">See client outcomes</a>
        </div>
      </div>

      <dl
        class="self-end border-t border-midnight-border-strong lg:col-span-5 animate-fade-up [animation-delay:240ms]"
      >
        {
          facts.map((f) => (
            <div class="grid grid-cols-[8.5rem_1fr] gap-4 border-b border-midnight-border py-4 sm:grid-cols-[10rem_1fr]">
              <dt class="text-sm text-ink-muted">{f.term}</dt>
              <dd class="text-[15px] leading-snug text-ink-primary">{f.detail}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <!-- Clients -->
    <div class="mt-20 border-t border-midnight-border pt-8">
      <p class="text-sm text-ink-muted">Trusted by 14+ East African enterprises, including</p>
      <ul class="mt-6 grid grid-cols-3 items-center gap-x-6 gap-y-8 sm:grid-cols-5 lg:flex lg:flex-wrap lg:justify-between lg:gap-x-8">
        {
          clients.map((c) => (
            <li class="flex h-10 items-center justify-center lg:justify-start">
              <img
                src={c.logo}
                alt={c.name}
                width={c.w}
                height={c.h}
                loading="lazy"
                decoding="async"
                class:list={["w-auto max-w-full object-contain opacity-70", c.cls]}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
