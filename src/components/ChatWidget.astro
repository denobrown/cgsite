---
// src/components/ChatWidget.astro
//
// Speed-conscious by design: the floating button below is plain static
// HTML/CSS — it's visible the instant the page paints, at zero JS cost.
// The actual chat PANEL markup is present but hidden, and
// public/scripts/chat-widget.js — the thing that knows how to open the
// panel, call /api/chat, and stream a response — is NOT loaded via a
// blocking <script> tag at all. It's fetched on first interaction (click
// or focus on the button), via a tiny inline bootstrap.
//
// That bootstrap is the one exception to "no inline scripts" on this site,
// and it's deliberately tiny and CONTENT-FIXED (identical on every page,
// like the Organization JSON-LD graph in Layout.astro) — so it contributes
// exactly one more stable, unchanging hash to the CSP's script-src, not a
// per-page-varying one. Run `npm run build` after ever touching this
// block; the header generator picks up its hash automatically same as
// every JSON-LD block on the site.
---

<div id="cga-chat-root" data-chat-root>
  <button
    type="button"
    id="cga-chat-toggle"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="cga-chat-panel"
    class="fixed bottom-5 right-5 z-40 flex h-14 w-14 items-center justify-center rounded-full border border-midnight-border bg-signal-blue text-white shadow-glow-blue transition-transform duration-200 hover:scale-105 sm:bottom-6 sm:right-6"
  >
    <svg id="cga-chat-icon-open" width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M4 5.5h14a1.5 1.5 0 0 1 1.5 1.5v7a1.5 1.5 0 0 1-1.5 1.5H9l-4 3v-3H4A1.5 1.5 0 0 1 2.5 14V7A1.5 1.5 0 0 1 4 5.5Z" stroke="white" stroke-width="1.4" stroke-linejoin="round" />
    </svg>
    <svg id="cga-chat-icon-close" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="hidden">
      <path d="M4 4l10 10M14 4 4 14" stroke="white" stroke-width="1.6" stroke-linecap="round" />
    </svg>
    <span class="sr-only">Open chat with CloudGrid Africa</span>
  </button>

  <div
    id="cga-chat-panel"
    role="dialog"
    aria-modal="false"
    aria-label="Chat with CloudGrid Africa"
    aria-hidden="true"
    class="fixed bottom-24 right-5 z-40 hidden h-[28rem] w-[22rem] max-w-[calc(100vw-2.5rem)] flex-col overflow-hidden rounded-xl border border-midnight-border bg-midnight-surface shadow-card-hover sm:right-6"
  >
    <div class="flex items-center justify-between border-b border-midnight-border px-4 py-3">
      <div>
        <p class="text-[13px] font-semibold text-white">CloudGrid Africa</p>
        <p class="flex items-center gap-1.5 text-[11px] text-ink-muted">
          <span class="h-1.5 w-1.5 rounded-full bg-signal-emerald"></span>
          Usually replies in a few seconds
        </p>
      </div>
    </div>

    <div id="cga-chat-messages" class="flex-1 space-y-3 overflow-y-auto px-4 py-4 text-[13.5px]" aria-live="polite">
      <div class="max-w-[85%] rounded-lg bg-midnight-raised px-3 py-2 text-ink-secondary">
        Hi — I can answer questions about CloudGrid Africa's services, compliance work, and how to get in touch.
        What are you looking to solve?
      </div>
    </div>

    <form id="cga-chat-form" class="flex items-center gap-2 border-t border-midnight-border p-3">
      <input
        id="cga-chat-input"
        type="text"
        autocomplete="off"
        placeholder="Ask a question…"
        class="flex-1 rounded-md border border-midnight-border bg-midnight-raised px-3 py-2 text-[13px] text-ink-primary placeholder:text-ink-faint focus:border-signal-blue"
      />
      <button
        type="submit"
        class="rounded-md bg-signal-blue-dim px-3 py-2 text-[13px] font-semibold text-white transition-all duration-200 hover:brightness-90"
      >
        Send
      </button>
    </form>
  </div>
</div>

<script is:inline>
  // Deliberately tiny, deliberately inline, deliberately IDENTICAL on every
  // page — see the frontmatter comment above for why that's safe under
  // this site's CSP. All it does is load the real widget script once, on
  // first genuine interaction, so a visitor who never opens the chat pays
  // zero extra JS cost for it.
  (function () {
    var toggle = document.getElementById("cga-chat-toggle");
    var loaded = false;
    function loadWidget() {
      if (loaded) return;
      loaded = true;
      var s = document.createElement("script");
      s.type = "module";
      s.src = "/scripts/chat-widget.js";
      document.body.appendChild(s);
    }
    toggle.addEventListener("click", loadWidget, { once: true });
    toggle.addEventListener("focus", loadWidget, { once: true });
  })();
</script>
