---
// src/components/BentoGrid.astro
// What happens to one M-Pesa payment, in order. Replaces a simulated code
// sample that didn't match Daraja's real callback shape (unsigned request,
// fields nested under Body.stkCallback). Each step describes standard
// Daraja behaviour, so there's nothing a developer can catch out.
const paymentSteps = [
  {
    title: "Customer approves the prompt",
    text: "An STK Push request puts the payment prompt on the customer's phone.",
  },
  {
    title: "Safaricom posts the result",
    text: "The callback endpoint only accepts requests from Safaricom's IP addresses. Daraja callbacks aren't signed, so the network rule does that job.",
  },
  {
    title: "Matched once, and only once",
    text: "The result is tied to its order by CheckoutRequestID. The M-Pesa receipt number is stored uniquely, so a repeated callback can't credit an order twice.",
  },
  {
    title: "Nothing left unexplained",
    text: "If a callback never arrives, the STK Push Query API confirms the outcome. Anything still unmatched goes to a person for review.",
  },
];

// Semantic web: each Bento quadrant is also a real Service offering — this
// is the actual list of things CloudGrid sells, so it's the natural place
// for Service schema to live rather than a generic services page nobody
// maintains. Kept in sync with the four cards below by construction (same
// source array), not duplicated by hand.
const services = [
  {
    name: "Cloud Engineering & Infrastructure",
    description: "Architecting, migrating, and optimizing hybrid workloads across AWS and Azure.",
    serviceType: "Cloud Infrastructure Engineering",
  },
  {
    name: "Cybersecurity",
    description: "Comprehensive penetration testing, OWASP hardening, and 24/7 proactive SOC monitoring.",
    serviceType: "Cybersecurity Services",
  },
  {
    name: "Data Protection & Privacy",
    description: "Full structural alignment and compliance deployment for the Kenya Data Protection Act 2019.",
    serviceType: "Data Protection Compliance",
  },
  {
    name: "Custom enterprise applications",
    description: "Bespoke transaction architectures, paperless automation systems, and high-performance M-Pesa API integrations.",
    serviceType: "Custom Software Development",
  },
];
---

<section id="capabilities" class="py-20 sm:py-28">
  <div class="cga-container">
    <div class="cga-section-head">
      <p class="cga-eyebrow">Capabilities</p>
      <h2 class="cga-section-title">
        Four disciplines. One engineering standard.
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-5 lg:grid-cols-12 lg:grid-rows-2">
      <!-- Q1 — Cloud Engineering & Infrastructure (large) -->
      <article class="cga-card group flex flex-col justify-between overflow-hidden p-8 lg:col-span-8 lg:row-span-1">
        <div>
          <div class="mb-5 flex h-5 w-5 items-center">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M5.5 12.5a3 3 0 0 1 0-6 3.75 3.75 0 0 1 7.24-1.14A2.75 2.75 0 0 1 12.25 12.5H5.5Z" stroke="#3A8AF1" stroke-width="1.5" stroke-linejoin="round" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white">Cloud engineering and infrastructure</h3>
          <p class="mt-2.5 max-w-md text-[15px] leading-relaxed text-ink-secondary">
            Architecting, migrating, and optimizing hybrid workloads across AWS and Azure.
          </p>
          <ul class="mt-6 grid gap-x-8 gap-y-2 text-[15px] text-ink-primary sm:grid-cols-2">
            <li>Migrations and landing zones</li>
            <li>Backup and disaster recovery</li>
            <li>Hybrid with on-prem at Raxio</li>
            <li>Cost and performance tuning</li>
          </ul>
        </div>
        <div class="mt-8 flex items-baseline gap-2 border-t border-midnight-border pt-5">
          <span class="font-mono text-2xl font-semibold text-signal-blue">40%</span>
          <span class="text-[13px] text-ink-muted">average reduction in downtime</span>
        </div>
      </article>

      <!-- Q2 — Cybersecurity (small) -->
      <article class="cga-card group flex flex-col justify-between p-8 lg:col-span-4 lg:row-span-1">
        <div>
          <div class="mb-5 flex h-5 w-5 items-center">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9 2.5 14.5 4.5v4c0 3.4-2.3 6.1-5.5 7-3.2-.9-5.5-3.6-5.5-7v-4L9 2.5Z" stroke="#3A8AF1" stroke-width="1.5" stroke-linejoin="round" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white">Cybersecurity</h3>
          <p class="mt-2.5 text-[15px] leading-relaxed text-ink-secondary">
            Comprehensive penetration testing, OWASP hardening, and 24/7 proactive SOC monitoring.
          </p>
        </div>
        <div class="mt-8 border-t border-midnight-border pt-5">
          <span class="inline-flex items-center gap-2 text-sm text-ink-secondary">
            <span class="h-1.5 w-1.5 rounded-full bg-signal-emerald" aria-hidden="true"></span>
            24/7 SOC monitoring
          </span>
        </div>
      </article>

      <!-- Q3 — Data Protection & Privacy (small) -->
      <article class="cga-card group flex flex-col justify-between p-8 lg:col-span-4 lg:row-span-1">
        <div>
          <div class="mb-5 flex h-5 w-5 items-center">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="4" y="8" width="10" height="7" rx="1.5" stroke="#3A8AF1" stroke-width="1.5" />
              <path d="M6.5 8V5.5a2.5 2.5 0 0 1 5 0V8" stroke="#3A8AF1" stroke-width="1.5" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white">Data protection and privacy</h3>
          <p class="mt-2.5 text-[15px] leading-relaxed text-ink-secondary">
            Full structural alignment and compliance deployment for the Kenya Data Protection Act 2019.
          </p>
        </div>
        <div class="mt-8 border-t border-midnight-border pt-5">
          <span class="inline-flex items-center gap-2 text-sm text-ink-secondary">
            <span class="h-1.5 w-1.5 rounded-full bg-signal-blue" aria-hidden="true"></span>
            Kenya DPA 2019 and ISO 27001 aligned
          </span>
        </div>
      </article>

      <!-- Q4 — Custom enterprise applications (large, with code snippet) -->
      <article class="cga-card group grid grid-cols-1 gap-6 overflow-hidden p-8 lg:col-span-8 lg:row-span-1 lg:grid-cols-[1fr_1.4fr] lg:items-center">
        <div>
          <div class="mb-5 flex h-5 w-5 items-center">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6 5 3 9l3 4M12 5l3 4-3 4M10.5 3.5 7.5 14.5" stroke="#3A8AF1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white">Custom enterprise applications</h3>
          <p class="mt-2.5 text-[15px] leading-relaxed text-ink-secondary">
            Bespoke transaction architectures, paperless automation systems, and high-performance
            M-Pesa API integrations.
          </p>
          <div class="mt-8 flex items-baseline gap-2 border-t border-midnight-border pt-5">
            <span class="whitespace-nowrap font-mono text-2xl font-semibold text-signal-blue">KES 18M+</span>
            <span class="text-[13px] text-ink-muted">processed</span>
          </div>
        </div>

        <!-- Payment flow: a real sequence, so numbered steps are earned -->
        <div class="-mx-2 rounded-lg border border-midnight-border bg-midnight p-5 sm:mx-0 sm:p-6">
          <p class="text-sm text-ink-muted">How one M-Pesa payment is handled</p>
          <ol class="mt-5 space-y-5">
            {
              paymentSteps.map((step, i) => (
                <li class="relative grid grid-cols-[1.75rem_1fr] gap-3">
                  {i < paymentSteps.length - 1 && (
                    <span
                      class="absolute left-[0.8125rem] top-7 h-[calc(100%-0.25rem)] w-px bg-midnight-border-strong"
                      aria-hidden="true"
                    ></span>
                  )}
                  <span class="flex h-7 w-7 items-center justify-center rounded-full border border-midnight-border-strong text-[13px] font-medium text-signal-blue" data-figure>
                    {i + 1}
                  </span>
                  <div class="pt-0.5">
                    <p class="text-[15px] font-medium text-white">{step.title}</p>
                    <p class="mt-1 text-sm leading-relaxed text-ink-secondary">{step.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </article>
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@graph": services.map((s) => ({
    "@type": "Service",
    "name": s.name,
    "description": s.description,
    "serviceType": s.serviceType,
    "provider": { "@id": "https://cloudgridafrica.com/#organization" },
    "areaServed": { "@type": "Country", "name": "Kenya" },
  })),
})} />
