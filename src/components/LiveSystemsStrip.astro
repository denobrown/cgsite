---
// src/components/LiveSystemsStrip.astro
//
// Security tip of the day. The live Nairobi clock and weather that used to
// sit beside it were removed (no client JS, no Open-Meteo request, one less
// CSP origin). The tip is resolved at BUILD TIME from
// src/data/security-tips.json and ships as static HTML. It advances daily
// because the scheduled daily-post job rebuilds the site once every 24h.

import tips from "../data/security-tips.json";

const now = new Date();
const dayIndex = (now.getUTCDate() - 1) % tips.length;
const todaysTip = tips[dayIndex];

const levelStyles: Record<string, string> = {
  info: "text-signal-emerald border-signal-emerald/30 bg-signal-emerald/10",
  advisory: "text-signal-amber border-signal-amber/30 bg-signal-amber/10",
};
---

<section aria-label="Security tip of the day" class="border-y border-midnight-border bg-midnight-surface">
  <div class="cga-container">
    <div class="flex flex-col gap-3 py-5 sm:flex-row sm:items-baseline sm:gap-6">
      <p class="flex shrink-0 items-center gap-3 text-sm text-ink-muted">
        Today's security tip
        <span
          class:list={[
            "rounded border px-1.5 py-0.5 text-xs font-medium",
            levelStyles[todaysTip.level],
          ]}
        >
          {todaysTip.tag}
        </span>
      </p>
      <p class="max-w-[80ch] text-[15px] leading-relaxed text-ink-primary">{todaysTip.tip}</p>
    </div>
  </div>
</section>
