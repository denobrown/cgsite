---
// src/components/CaseStudies.astro
const cases = [
  {
    sector: "Real estate and payments",
    client: "Capitol Realtors",
    metric: "KES 18M+",
    metricLabel: "processed",
    text: "Rebuilt the production infrastructure behind high-volume customer transactions. No incidents since go-live.",
  },
  {
    sector: "Performance and scaling",
    client: "PrimeDrive Imports",
    metric: "3x",
    metricLabel: "lead conversions",
    text: "Cut page load time from 3.2 seconds to under 50 ms. Lead conversions tripled after the rebuild.",
  },
  {
    sector: "Healthcare operations",
    client: "BXA Special Medical Centre",
    metric: "4hr",
    metricLabel: "payroll run, now automated",
    text: "Moved manual operations, payroll included, onto automated cloud workflows with regulatory controls built in.",
  },
];

const standards = ["Kenya DPA 2019", "ISO 27001", "OWASP Top 10", "NIST CSF", "GDPR"];
---

<section id="case-studies" class="py-20 sm:py-28">
  <div class="cga-container">
    <div class="cga-section-head">
      <p class="cga-eyebrow">Case studies</p>
      <h2 class="cga-section-title">
        Outcomes, not testimonials.
      </h2>
    </div>

    <!-- Rows, not a three-card strip: the figure leads each row, client and
         context follow. Collapses to a single column below md. -->
    <ol class="divide-y divide-midnight-border border-y border-midnight-border">
      {
        cases.map((item) => (
          <li class="grid grid-cols-1 gap-3 py-8 md:grid-cols-12 md:gap-8 md:py-10">
            <div class="md:col-span-3">
              <p class="text-4xl font-semibold tracking-[-0.03em] text-signal-blue sm:text-5xl" data-figure>
                {item.metric}
              </p>
              <p class="mt-1 text-sm text-ink-muted">{item.metricLabel}</p>
            </div>
            <div class="md:col-span-4 md:pt-2">
              <h3 class="text-lg font-semibold text-white">{item.client}</h3>
              <p class="mt-1 text-sm text-ink-muted">{item.sector}</p>
            </div>
            <p class="max-w-[60ch] text-[15px] leading-relaxed text-ink-secondary md:col-span-5 md:pt-2">
              {item.text}
            </p>
          </li>
        ))
      }
    </ol>

    <!-- Compliance banner -->
    <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-3 border-b border-midnight-border pb-8">
      <p class="w-full text-sm text-ink-muted sm:w-auto">Frameworks we build against</p>
      {
        standards.map((standard, i) => (
          <>
            <span class="text-[15px] font-medium text-ink-secondary">
              {standard}
            </span>
          </>
        ))
      }
    </div>
  </div>
</section>
