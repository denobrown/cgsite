# Copy this file's contents into your host's environment variable settings
# (Vercel: Project Settings → Environment Variables. Netlify: Site
# configuration → Environment variables). Never commit an actual .env file
# with real values — .gitignore already excludes .env / .env.production.

# --- Daily blog auto-publish (api/generate-daily-post.js / netlify/functions/generate-daily-post.js) ---

# Fine-grained GitHub PAT scoped to Contents: Read & Write on ONLY the
# cloudgridafrica.com repository.
GITHUB_TOKEN=

# "owner/repo", e.g. cloudgridafrica/cloudgridafrica-com
GITHUB_REPO=

# Defaults to "main" if unset.
GITHUB_BRANCH=main

# Vercel only: set this to any random secret string, then add the SAME
# value in Vercel's dashboard. Vercel automatically sends it as
# `Authorization: Bearer <value>` when its own Cron scheduler calls
# api/generate-daily-post — without it, that endpoint is a public URL
# anyone could hit to force a commit against your repo.
CRON_SECRET=

# --- Contact form (api/contact.js / netlify/functions/contact.js) ---

# From https://resend.com — free tier, no card required for low volume.
# Create an API key scoped to "Sending access" only.
RESEND_API_KEY=

# --- Chat widget (api/chat.js / netlify/functions/chat.js) ---

# From https://console.anthropic.com — the chat widget calls Claude
# server-side only; the browser never sees this key. Without it, the widget
# still opens and responds with a clear "not configured yet" message rather
# than failing silently.
ANTHROPIC_API_KEY=
